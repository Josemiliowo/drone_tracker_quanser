# ROS 2 Humble + librealsense + realsense-ros + vision_msgs + ultralytics for the QDrone 2 Jetson Xavier NX.
#
# Check the L4T version on the drone first:   cat /etc/nv_tegra_release   (e.g. R35 REVISION 4.1)
# and set L4T to match. Base image: https://github.com/dusty-nv/jetson-containers
#
# Build (on the Jetson):  docker build -t fire_drone -f docker/Dockerfile.jetson .
# Run:
#   docker run -it --rm --runtime nvidia --network host --ipc host --privileged \
#     -v /dev:/dev -v ~/models:/models -v ~/fire_drone_ws:/ws fire_drone
#   (inside) cd /ws && colcon build --symlink-install && source install/setup.bash
#            ros2 launch fire_mapper drone1.launch.py model:=/models/best.engine
ARG L4T=r35.4.1
FROM dustynv/ros:humble-ros-base-l4t-${L4T}

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake build-essential libssl-dev libusb-1.0-0-dev libudev-dev pkg-config \
      libgtk-3-dev python3-pip chrony && rm -rf /var/lib/apt/lists/*

# librealsense with the RSUSB backend (no kernel patching needed on Jetson)
RUN git clone --depth 1 -b v2.55.1 https://github.com/IntelRealSense/librealsense.git /tmp/librealsense && \
    cd /tmp/librealsense && mkdir build && cd build && \
    cmake .. -DFORCE_RSUSB_BACKEND=ON -DBUILD_WITH_CUDA=ON -DBUILD_EXAMPLES=OFF -DBUILD_GRAPHICAL_EXAMPLES=OFF \
             -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && rm -rf /tmp/librealsense

# ROS packages not in the base image (dustynv images build ROS from source, so no apt ros-humble-*)
RUN mkdir -p /opt/deps_ws/src && cd /opt/deps_ws/src && \
    git clone --depth 1 -b 4.55.1 https://github.com/IntelRealSense/realsense-ros.git && \
    git clone --depth 1 -b ros2 https://github.com/ros-perception/vision_msgs.git && \
    git clone --depth 1 -b humble https://github.com/ros-perception/vision_opencv.git && \
    cd /opt/deps_ws && source /opt/ros/humble/install/setup.bash && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release \
      --packages-select realsense2_camera_msgs realsense2_camera vision_msgs cv_bridge && \
    echo 'source /opt/deps_ws/install/setup.bash' >> /root/.bashrc

# YOLO. Use the Jetson torch wheel that matches your JetPack (dustynv l4t-pytorch has them),
# otherwise ultralytics pulls a CPU-only torch. TensorRT python bindings come with JetPack.
RUN pip3 install --no-cache-dir "ultralytics>=8.4,<8.5" "numpy<2" pyyaml   # model was trained with 8.4.x

WORKDIR /ws
